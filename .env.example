# ---- MetricAI ----
METRICAI_API_KEY="metricai_api key"
# Optional: override if you were given a non-default proxy host
# METRICAI_BASE_URL=https://api.metricai.co.in

# ---- Azure OpenAI (BYOK: MetricAI forwards these, never stores them) ----
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployment names in YOUR Azure resource (not model names).
# CHEAP is used for triage/critique/summarise, SMART for drafting.
AZURE_DEPLOYMENT_CHEAP=gpt-4o-mini
AZURE_DEPLOYMENT_SMART=gpt-4o

# ---- Local cost model (for reconciliation against MetricAI) ----
# USD per 1M tokens, as published by Azure for the underlying models.
PRICE_CHEAP_IN_USD_PMT=0.15
PRICE_CHEAP_OUT_USD_PMT=0.60
PRICE_SMART_IN_USD_PMT=2.50
PRICE_SMART_OUT_USD_PMT=10.00
USD_INR=88.0
