# ---- MetricAI ----
METRICAI_API_KEY="metricai_api key"
# Optional: override if you were given a non-default proxy host
# METRICAI_BASE_URL=https://api.metricai.co.in

# ---- Provider keys (BYOK: MetricAI forwards these, never stores them) ----
# CHEAP tier (triage/critique/summarise) runs on Gemini.
GEMINI_API_KEY=your_gemini_key
# Use a concrete model name: MetricAI needs a priced model, and it has no rate
# for the "gemini-flash-latest" alias (the proxy returns pricing_not_configured).
GEMINI_MODEL_CHEAP=gemini-3.6-flash

# SMART tier (drafting) runs on Azure OpenAI.
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Deployment name in YOUR Azure resource (not a model name).
AZURE_DEPLOYMENT_SMART=gpt-4o

# ---- Local cost model (for reconciliation against MetricAI) ----
# USD per 1M tokens, as published by Google (cheap) and Azure (smart).
PRICE_CHEAP_IN_USD_PMT=1.50
PRICE_CHEAP_OUT_USD_PMT=7.50
PRICE_SMART_IN_USD_PMT=2.50
PRICE_SMART_OUT_USD_PMT=10.00
USD_INR=88.0
